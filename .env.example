# Kopiér denne fil til .env og udfyld vaerdierne.
# .env er ikke i versionsstyring — API-noeglen maa ikke committes.
#
# Bruges KUN til lokal udvikling og til scripts/hent_eksempel_submission.py.
# Naar robotten koerer i produktion henter den alt fra OpenOrchestrator i stedet,
# se robot_framework/config.py.

# --- OS2Forms ---
# Base-URL uden efterstillet skraastreg, fx https://selvbetjening.aarhuskommune.dk
OS2FORMS_BASE_URL=
# Blankettens maskinnavn i OS2Forms
OS2FORMS_WEBFORM_ID=
# API-noegle for en bruger med rollen "OS2Form REST API user",
# som har faaet adgang til netop denne blanket.
# Hentes paa /user/<bruger-id>/key-auth i OS2Forms.
OS2FORMS_API_KEY=

# --- SharePoint (kun noedvendig ved lokal koersel mod SharePoint) ---
SHAREPOINT_URL=

# --- OpenOrchestrator (kun noedvendig ved lokal koersel mod OO) ---
OpenOrchestratorConnString=
OpenOrchestratorKey=

# Credentials og constants i OpenOrchestrator. Samme navne som de oevrige
# MTM-robotter bruger, saa de findes formentlig allerede:
#
#   Credentials:
#     "OS2FormsAPI"      username = API base-URL,  password = API-noeglen
#     "SharePointAPI"    username = tenant-id,     password = client-id
#     "SharePointCert"   username = thumbprint,    password = sti til .pem-fil
#
#   Constants:
#     "AarhusKommuneSharePoint"  base-URL til SharePoint
#     "Error Email"              modtager af fejlmails
#
# Blankettens maskinnavn og sitets sti staar i robot_framework/config.py
# (WEBFORM_ID og SHAREPOINT_SITE_PATH), ikke som constants.
